# Copy to .env and change the values. Never commit .env.

# The host's master key: can do everything (all lessons, all webhooks).
# Lesson providers get their own keys at /get-key; they never need this one.
# If unset, the server makes up a new one at each start and prints it.
ADMIN_TOKEN=change-me-to-a-long-random-code

# Port the server listens on.
PORT=8080

# Where lessons and generated files are kept (default: ./data).
# DATA_DIR=/data

# This server's public address, used in links, embed code and certificates (on Render it is found automatically).
# PUBLIC_URL=https://learn.example.org

# Behind a hosting load balancer (Render, Fly…): 1 = trust one proxy, for correct https links and client addresses.
# TRUST_PROXY=1

# Provider keys from the /get-key page: open (anyone, within the limits below) or closed (master key only).
SIGNUP=open
PROVIDER_MAX_LESSONS=10
PROVIDER_MAX_UPLOAD_MB=200
PROVIDER_MAX_JOBS=50

# Speech model for automatic captions: any OpenAI-style /v1/audio/transcriptions server, e.g. local faster-whisper
# (docker compose --profile asr up). Leave empty to write captions by hand only. Nothing is sent anywhere unless this is set.
# ASR_URL=http://localhost:8000
# ASR_MODEL=Systran/faster-whisper-small
