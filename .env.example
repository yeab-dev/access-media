# Copy to .env and change the values. Never commit .env.

# Staff access code for uploading sign language recordings (studio/sign.html).
# If unset, the server makes up a new one at each start and prints it.
ADMIN_TOKEN=change-me-to-a-long-random-code

# Port the server listens on.
PORT=8080

# Where lessons and generated files are kept (default: ./data).
# DATA_DIR=/data
